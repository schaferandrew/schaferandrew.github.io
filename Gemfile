source "https://rubygems.org"
# The same Jekyll and plugins GitHub Pages builds the site with. Ruby version: .ruby-version.
#     bundle install
#     bundle exec jekyll serve      # http://localhost:4000
# To follow a newer Pages release: bundle update github-pages
gem "github-pages", group: :jekyll_plugins
# Ruby 3 no longer ships the web server `jekyll serve` uses
gem "webrick"
